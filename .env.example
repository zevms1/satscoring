# Supabase project settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://zvvxmwnyrdzkrkbeftes.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_04S_-K3YIaHvY8jB09YrXA_kAV4VQez

# Supabase project settings -> API -> service_role secret key.
# SERVER-SIDE ONLY. Never prefix with NEXT_PUBLIC_. Used only by api/parse.py.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret so api/parse.py only accepts calls from this app's own
# upload action, not from the public internet. Generate any random string,
# e.g. `openssl rand -hex 32`, and use the same value in both places.
INTERNAL_API_SECRET=

# Browserless.io account -> API token. Used by app/api/generate-pdf to render
# score reports to PDF via hosted headless Chrome, so printed/saved reports
# look identical for every student regardless of local print-dialog settings.
# Sign up at https://www.browserless.io/, grab the token from your account
# dashboard (which also shows your account's actual /pdf endpoint region --
# override BROWSERLESS_URL below if it differs from the default).
BROWSERLESS_TOKEN=
# BROWSERLESS_URL=https://production-sfo.browserless.io/pdf
